# =============================================================================
# Modello del file .env  ->  copiarlo in .env e compilarlo:
#     cp .env.example .env        (PowerShell: Copy-Item .env.example .env)
#
# .env NON va committato (è nel .gitignore): contiene i client secret OAuth.
# Docker Compose legge .env in automatico e sostituisce le ${VARIABILI} usate
# in docker-compose.yml.
# =============================================================================

# --- Google: console.cloud.google.com -> API e servizi -> Credenziali -> ID client OAuth
#     Tipo "Applicazione web", URI di reindirizzamento autorizzato:
#     http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- GitHub: Settings -> Developer settings -> OAuth Apps -> New OAuth App
#     Homepage URL: http://localhost:8080
#     Authorization callback URL: http://localhost:8080/login/oauth2/code/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Ruoli GinVault --------------------------------------------------------
# Elenchi separati da virgola di identità nella forma:
#     google:<email>     (es. google:mario.rossi@gmail.com)
#     github:<login>     (es. github:mrossi)
# Un utente può stare in più elenchi (= più ruoli).
# Chi non compare in NESSUN elenco riceve il ruolo CLIENTE.
RUOLI_SOCIO=
RUOLI_DISTILLATORE=
RUOLI_RESP_ACQUISTI=
RUOLI_ADMIN=
