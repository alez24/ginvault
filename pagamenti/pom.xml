<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Il parent di Spring Boot fornisce:
        - le versioni compatibili di tutte le dipendenze Spring/terze parti (non le scriviamo noi);
        - la configurazione dei plugin Maven (compiler, surefire, spring-boot-maven-plugin...).
        relativePath vuoto = cercalo nel repository Maven, non in una cartella padre:
        ogni servizio è un progetto Maven indipendente.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>it.ginvault</groupId>
    <artifactId>pagamenti</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>pagamenti</name>
    <description>GinVault - microservizio Pagamenti</description>

    <properties>
        <!-- Letta dal parent per configurare il compilatore (release 21) -->
        <java.version>21</java.version>
        <!--
            SDK ufficiale di Stripe. La versione fissa anche la versione dell'API
            di Stripe usata nelle chiamate (Stripe.API_VERSION, 2026-10-28.endive).
        -->
        <stripe.version>34.1.0</stripe.version>
    </properties>

    <dependencies>
        <!-- API REST: Spring MVC + Tomcat embedded -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Endpoint di monitoraggio: da qui arriva GET /health -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!--
            Spring for Apache Kafka: il consumer @KafkaListener di pagamenti.comandi
            e il KafkaTemplate (publisher dell'outbox e dead letter). Versione gestita dal parent.
        -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <!-- Stripe in modalità test: PaymentIntent e rimborsi, chiamati dal server -->
        <dependency>
            <groupId>com.stripe</groupId>
            <artifactId>stripe-java</artifactId>
            <version>${stripe.version}</version>
        </dependency>

        <!-- Accesso al DB: JPA/Hibernate + pool di connessioni HikariCP -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Driver JDBC di PostgreSQL: serve solo a runtime, non in compilazione -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            Spring Security come "resource server": accetta solo richieste con un
            JWT valido (firmato dal gateway) nell'header Authorization.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!-- Test: JUnit 5, AssertJ, MockMvc... -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            Testcontainers: nei test di integrazione avvia un PostgreSQL e un Kafka
            VERI in container Docker usa-e-getta (serve Docker in esecuzione).
            @ServiceConnection collega da soli datasource e Kafka ai container.
            Versioni gestite dal parent di Spring Boot.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>kafka</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Awaitility: "aspetta finché l'esito è su Kafka" senza sleep fissi -->
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            WireMock: uno Stripe FINTO nei test, un server HTTP vero su una porta
            casuale che risponde come l'API di Stripe (pagamento riuscito, carta
            rifiutata, errore 500, lentezza). La versione standalone ha le sue
            dipendenze dentro il jar e non si scontra con quelle di Spring Boot.
        -->
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <version>3.13.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Crea il "fat jar" eseguibile con java -jar (codice + tutte le dipendenze) -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
