<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>it.ginvault</groupId>
    <artifactId>gateway</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>gateway</name>
    <description>GinVault - API Gateway (punto di ingresso unico)</description>

    <properties>
        <java.version>21</java.version>
        <!-- Release train di Spring Cloud compatibile con Spring Boot 3.5.x -->
        <spring-cloud.version>2025.0.3</spring-cloud.version>
    </properties>

    <!--
        BOM di Spring Cloud: fissa le versioni di tutti i moduli Spring Cloud.
        A differenza del <parent>, qui importiamo solo le versioni ("scope import"),
        senza ereditare altra configurazione.
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!--
            Spring Cloud Gateway in versione reattiva (WebFlux + Netty, non Tomcat):
            un gateway passa il tempo ad aspettare risposte dai servizi a valle,
            e il modello non bloccante gestisce molte richieste con pochi thread.
        -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway-server-webflux</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!--
            Spring Security + client OAuth2: login con Google/GitHub (oauth2Login).
            Porta con sé anche spring-security-oauth2-jose (libreria Nimbus), che
            usiamo per FIRMARE il JWT interno e pubblicare la chiave pubblica (JWKS).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-client</artifactId>
        </dependency>

        <!-- Test: JUnit 5, AssertJ, WebTestClient... -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Test: utenti finti già autenticati (mockOAuth2Login) -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
