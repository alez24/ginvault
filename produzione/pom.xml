<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Il parent di Spring Boot fornisce:
        - le versioni compatibili di tutte le dipendenze Spring/terze parti (non le scriviamo noi);
        - la configurazione dei plugin Maven (compiler, surefire, spring-boot-maven-plugin...).
        relativePath vuoto = cercalo nel repository Maven, non in una cartella padre:
        ogni servizio è un progetto Maven indipendente.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>it.ginvault</groupId>
    <artifactId>produzione</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>produzione</name>
    <description>GinVault - microservizio Produzione</description>

    <properties>
        <!-- Letta dal parent per configurare il compilatore (release 21) -->
        <java.version>21</java.version>
        <!-- La stessa di giacenze-api: tutte le librerie io.grpc alla stessa versione -->
        <grpc.version>1.85.1</grpc.version>
    </properties>

    <dependencies>
        <!-- API REST: Spring MVC + Tomcat embedded -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Bean Validation (@NotNull, @Positive...) sui corpi delle richieste REST -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Endpoint di monitoraggio: da qui arriva GET /health -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Accesso al DB: JPA/Hibernate + pool di connessioni HikariCP -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Driver JDBC di PostgreSQL: serve solo a runtime, non in compilazione -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            Spring Security come "resource server": accetta solo richieste con un
            JWT valido (firmato dal gateway) nell'header Authorization.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!--
            Spring for Apache Kafka: il KafkaTemplate (publisher dell'outbox e dead letter) e i consumer
            @KafkaListener di edizioni.eventi e magazzino.eventi. Versione gestita dal parent.
        -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <!--
            gRPC: il contratto Giacenze del magazzino (messaggi e stub client)
            generato dal modulo condiviso giacenze-api, da installare prima con
            mvn -f ../giacenze-api/pom.xml install (il Dockerfile lo fa da solo).
        -->
        <dependency>
            <groupId>it.ginvault</groupId>
            <artifactId>giacenze-api</artifactId>
            <version>0.1.0</version>
        </dependency>
        <!--
            Il trasporto HTTP/2 del canale gRPC. "shaded": Netty è dentro il jar
            con un altro package, quindi non si scontra con niente. Compile e non
            runtime: i test avviano un magazzino finto con lo stesso trasporto.
        -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-netty-shaded</artifactId>
            <version>${grpc.version}</version>
        </dependency>

        <!-- Test: JUnit 5, AssertJ, MockMvc... -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            Testcontainers: nei test di integrazione avvia un PostgreSQL e un Kafka
            VERI in container Docker usa-e-getta (serve Docker in esecuzione).
            @ServiceConnection collega da soli datasource e Kafka ai container.
            Versioni gestite dal parent di Spring Boot.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>kafka</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Awaitility: "aspetta finché l'evento è su Kafka" senza sleep fissi -->
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Crea il "fat jar" eseguibile con java -jar (codice + tutte le dipendenze) -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
